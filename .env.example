# Copy this file to ".env" and change the values if needed.
# The same values are used by docker-compose.yml and by the FastAPI application.

POSTGRES_USER=jobs_user
POSTGRES_PASSWORD=jobs_password
POSTGRES_DB=jobs_db
POSTGRES_HOST=localhost

# Change this to 5433 if port 5432 is already used on your computer.
POSTGRES_PORT=5432
